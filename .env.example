# Copy this file to .env and fill in the CHANGE_ME values.
# All other settings have working defaults.
#
#   cp .env.example .env

# ── postbot (required) ──────────────────────────────────────────────────────
URL=mattermost.yourdomain.com        # hostname only — no https://
TOKEN=CHANGE_ME                      # bot account access token
TEAM_NAME=CHANGE_ME                  # Mattermost team slug (lowercase)
WEBUI_API_SECRET=CHANGE_ME           # shared secret between postbot and webui (any long random string)

# ── postbot (optional — override these as needed) ────────────────────────────
SESSION_TTL_SECONDS=300
SESSION_CLEANUP_INTERVAL_SECONDS=60
CHANNEL_CACHE_TTL_SECONDS=3600
LOG_LEVEL=INFO                       # file log level (DEBUG|INFO|WARNING|ERROR)
CONSOLE_LOG_LEVEL=WARNING            # stdout log level
LOG_FILE=logs/bot.log                # local dev default; set to /app/data/logs/bot.log in containers
DB_PATH=broadcast_log.db             # local dev default; set to /app/data/broadcast_log.db in containers
BOT_LOG_CHANNEL_ID=                  # channel ID for broadcast audit posts — empty = disabled

# ── webui (required) ────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=CHANGE_ME          # long random string — keep secret, never commit
ALLOWED_HOSTS=yourdomain.com,localhost
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME

# ── webui (Keycloak login) ──────────────────────────────────────────────────
OIDC_RP_CLIENT_SECRET=CHANGE_ME
# KEYCLOAK_REALM_URL=https://id.ca-hd.de/realms/collegium
# OIDC_RP_CLIENT_ID=postbot
# Members of this group get BotAdmin (matched by its cn against the Keycloak "groups" claim).
# LDAP_ADMIN_GROUP_DN=cn=bot-admins,ou=groups,dc=example,dc=com

# ── container paths (docker compose deployment) ──────────────────────────────
# Uncomment these when deploying via docker compose.
# They override the local-dev defaults above to point inside the container's
# bind-mounted data directory.
#
# CHANNELS_TOML_PATH=/app/data/channels.toml
# DB_PATH=/app/data/broadcast_log.db
# SCHEDULER_TOML_PATH=/app/data/scheduler.toml
# LOG_FILE=/app/data/logs/bot.log
